# Designer Kid — environment variables
# Copy to .env.local and fill in. Never commit .env.local.
# See docs/ENVIRONMENT.md for details.

# ── Supabase (optional) ───────────────────────────────────────────────
# Leave BOTH empty to run in browser-only mode (everything in localStorage).
# Values: Supabase dashboard → Project Settings → Data API (URL) and API Keys (publishable key).
# Use the PUBLISHABLE key (sb_publishable_…) only — never the secret / service_role key.
# These are embedded in the public JS bundle at build time.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# ── Build (set automatically by .github/workflows/deploy.yml) ─────────
# Base URL path the site is served from. "/" locally; "/designer-kid/" on GitHub Pages.
# BASE_PATH=/designer-kid/

# ── Development only ──────────────────────────────────────────────────
# Set to "off" to start the dev server without the Motion Studio panel (e.g. for browser tests).
# MOTION_STUDIO=off
# Motion Studio agent provider (only with a Motion Studio subscription): claude | cursor | codex
MOTION_STUDIO_AGENT_PROVIDER=claude
